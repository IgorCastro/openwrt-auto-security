config auto_security 'core'
	option attack_threshold '3'
	option scan_interval '10'
	option ban_duration '0'
	option log_retention '30'

config auto_security 'ipv6'
	option enable_ipv6 '1'

config auto_security 'cidr'
	option enable_cidr_ban '1'
	option cidr_threshold '8'
	option cidr_prefix '24'

config auto_security 'features'
	option enable_auto_ban '1'
	option enable_monitoring '1'
	option enable_alerts '1'
	option enable_correlation '1'

config auto_security 'alerts'
	option alert_methods 'log'
	option alert_webhook_url ''
	option alert_email ''
	option smtp_server ''
	option smtp_port '587'
	option smtp_user ''
	option smtp_pass ''
	option alert_on_new_ban '1'
	option alert_on_cidr_ban '1'
	option alert_high_volume '50'

config auto_security 'correlation'
	option enable_mwan3 '1'
	option mwan3_interfaces 'wan wanb'
	option enable_adguard '1'
	option adguard_api_url 'http://127.0.0.1:3000'
	option adguard_api_user 'admin'
	option adguard_api_pass_file '/root/adguard-admin.txt'
	option enable_netdata '1'
	option netdata_api_url 'http://127.0.0.1:19999'

config auto_security 'thresholds'
	option ssh_threshold '3'
	option http_threshold '15'
	option https_threshold '10'
	option rdp_threshold '2'
	option dns_threshold '30'
	option smtp_threshold '5'

config auto_security 'advanced'
	option nft_chain 'input_wan'
	option nft_table 'inet fw4'
	option log_prefix 'Log-Blocked-WAN-Access'
	option max_log_entries '5000'
	option live_timeout '300'
	option auto_save '1'
	option auto_restore '1'